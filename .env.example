API_KEY=your-secret-api-key-change-this
PORT=8080
HOST=0.0.0.0
WEB_PATH= # 留空为根路径 /，设置为 /web 则通过 /web 访问

# Storage Configuration
STORAGE_TYPE=json  # "json" 或者 "hf"
STORAGE_PATH=./data/configs  # 当 STORAGE_TYPE=json 时有效
HF_REPO_ID=chence0918/subconverter-data  # 当 STORAGE_TYPE=hf 时填入你的数据集 ID
HF_TOKEN=your_huggingface_token  # 当 STORAGE_TYPE=hf 时填入你的 HF Access Token

# Logging Configuration
LOG_LEVEL=INFO  # 可选: DEBUG, INFO, WARN, ERROR
